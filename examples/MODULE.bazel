module(
    name = "examples",
)

# Dependencies
bazel_dep(name = "federated_language")
local_path_override(
    module_name = "federated_language",
    path = "..",
)
local_path_override(
    module_name = "grpc-java",
    path = "../third_party/grpc-java-mock",
)



bazel_dep(name = "protobuf", version = "32.1")
bazel_dep(name = "rules_python", version = "2.0.1")

# Python Toolchain
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.12",
)

# Python Dependencies
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "examples_pypi",
    python_version = "3.12",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "examples_pypi")

single_version_override(
    module_name = "grpc",
    patch_strip = 1,
    version = "1.78.0",
    patches = [
        "//:grpc.patch",
    ],
)
